<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="UTF-8">
    <!-- 适配手机网页，禁止双击缩放 -->
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>For My Muse - 专属高定画廊</title>

    <!-- 引入优雅的英文字体 -->
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,700;1,400&display=swap" rel="stylesheet">
    
    <!-- MediaPipe AI 手势库 -->
    <script src="https://cdn.jsdelivr.net/npm/@mediapipe/camera_utils/camera_utils.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/@mediapipe/hands/hands.js"></script>

    <style>
        /* ====== 高级感极简暗黑主题 ====== */
        :root {
            --bg-color: #050505;
            --text-gold: #D4AF37;
            --text-light: #F5F5F7;
        }

        body, html {
            margin: 0; padding: 0; width: 100%; height: 100%;
            background-color: var(--bg-color);
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
            overflow: hidden;
            color: var(--text-light);
        }

        /* 背景氛围光 */
        .ambient-light {
            position: absolute; top: 50%; left: 50%; width: 80vw; height: 80vw;
            background: radial-gradient(circle, rgba(212, 175, 55, 0.05) 0%, rgba(0,0,0,0) 70%);
            transform: translate(-50%, -50%); pointer-events: none; z-index: 0;
        }

        /* 顶部文案区 */
        .header {
            position: absolute; top: 8%; width: 100%; text-align: center; z-index: 10;
        }
        .header h1 {
            font-family: 'Playfair Display', serif; font-size: 28px; font-weight: 400;
            letter-spacing: 4px; color: var(--text-gold); margin: 0 0 10px 0;
        }
        .header p {
            font-size: 13px; font-weight: 300; letter-spacing: 2px; color: rgba(255,255,255,0.5); margin: 0;
        }

        /* 画廊景深容器 */
        .gallery-container {
            position: relative; width: 100vw; height: 100vh;
            display: flex; align-items: center; justify-content: center;
            perspective: 1200px; z-index: 5;
        }

        /* 单张卡片样式 */
        .card {
            position: absolute;
            width: 65vw; max-width: 320px;
            aspect-ratio: 3 / 4; /* 经典人像比例 */
            border-radius: 12px;
            background-size: cover; background-position: center;
            box-shadow: 0 20px 50px rgba(0,0,0,0.8);
            /* 丝滑过渡动画，高级感来源 */
            transition: all 0.7s cubic-bezier(0.25, 1, 0.2, 1);
            cursor: pointer;
            border: 1px solid rgba(255, 255, 255, 0.1);
            -webkit-user-select: none;
        }

        /* ====== 卡片状态 (3D Cover Flow) ====== */
        .card.active {
            transform: translateX(0) translateZ(0) scale(1);
            z-index: 10; filter: brightness(1); opacity: 1;
        }
        .card.prev {
            transform: translateX(-40vw) translateZ(-200px) rotateY(15deg);
            z-index: 5; filter: brightness(0.3) blur(3px); opacity: 0.8; pointer-events: none;
        }
        .card.next {
            transform: translateX(40vw) translateZ(-200px) rotateY(-15deg);
            z-index: 5; filter: brightness(0.3) blur(3px); opacity: 0.8; pointer-events: none;
        }
        .card.hidden-left {
            transform: translateX(-80vw) translateZ(-400px);
            z-index: 1; opacity: 0; pointer-events: none;
        }
        .card.hidden-right {
            transform: translateX(80vw) translateZ(-400px);
            z-index: 1; opacity: 0; pointer-events: none;
        }

        /* ====== 抽取放大模态框 ====== */
        .zoom-modal {
            position: fixed; inset: 0; background: rgba(0,0,0,0.95);
            display: flex; align-items: center; justify-content: center;
            opacity: 0; pointer-events: none; z-index: 999;
            backdrop-filter: blur(15px); -webkit-backdrop-filter: blur(15px);
            transition: opacity 0.5s cubic-bezier(0.25, 1, 0.2, 1);
        }
        .zoom-modal.active { opacity: 1; pointer-events: auto; }
        
        .zoom-img {
            max-width: 90vw; max-height: 85vh; border-radius: 8px;
            box-shadow: 0 10px 40px rgba(212, 175, 55, 0.2);
            transform: scale(0.8) translateY(20px);
            transition: transform 0.5s cubic-bezier(0.25, 1, 0.2, 1);
        }
        .zoom-modal.active .zoom-img { transform: scale(1) translateY(0); }

        /* 摄像头小窗 (极其克制，悬浮在角落) */
        #camera-wrapper {
            position: fixed; bottom: 20px; right: 20px;
            width: 60px; height: 60px; border-radius: 50%; overflow: hidden;
            border: 2px solid rgba(212, 175, 55, 0.5); z-index: 100;
            box-shadow: 0 4px 15px rgba(0,0,0,0.5);
            transition: opacity 0.3s;
        }
        .input_video { display: none; }
        .output_canvas { width: 100%; height: 100%; transform: scaleX(-1); object-fit: cover; }
        
        /* 状态提示 */
        #status-tip {
            position: fixed; bottom: 35px; width: 100%; text-align: center;
            font-size: 12px; color: rgba(255,255,255,0.4); z-index: 10;
            letter-spacing: 1px; pointer-events: none;
        }
    </style>
</head>
<body>

    <div class="ambient-light"></div>

    <div class="header">
        <h1>To My Muse</h1>
        <p>女神节快乐 · 永远做自己的光</p>
    </div>

    <!-- 画廊容器 -->
    <div class="gallery-container" id="gallery">
        <!-- 图片由 JS 动态生成 -->
    </div>

    <!-- 底部手势指引 -->
    <div id="status-tip">AI 加载中... 请稍候</div>

    <!-- 抽取放大全屏容器 -->
    <div class="zoom-modal" id="zoom-modal" onclick="closeZoomFallback()">
        <img src="" class="zoom-img" id="zoom-img">
    </div>

    <!-- 摄像头隐蔽小窗 -->
    <div id="camera-wrapper">
        <video class="input_video"></video>
        <canvas class="output_canvas" width="160" height="160"></canvas>
    </div>

    <script>
        // ==========================================
        // 🌟 核心配置区 🌟
        // ==========================================
        const PHOTOS =[
            "https://images.unsplash.com/photo-1534528741775-53994a69daeb?auto=format&fit=crop&w=600&q=80",
            "https://images.unsplash.com/photo-1517841905240-472988babdf9?auto=format&fit=crop&w=600&q=80",
            "https://images.unsplash.com/photo-1524504388940-b1c1722653e1?auto=format&fit=crop&w=600&q=80",
            "https://images.unsplash.com/photo-1506794778202-cad84cf45f1d?auto=format&fit=crop&w=600&q=80",
            "https://images.unsplash.com/photo-1488161628813-04466f87258a?auto=format&fit=crop&w=600&q=80"
        ];
        
        // ==========================================
        // UI & 轮播图逻辑
        // ==========================================
        let currentIndex = 0;
        const gallery = document.getElementById('gallery');
        const cards =[];

        // 初始化图片卡片
        PHOTOS.forEach((src, index) => {
            const div = document.createElement('div');
            div.className = 'card';
            div.style.backgroundImage = `url(${src})`;
            // 添加点击事件：手机端没有手势时也可以点击放大/切换
            div.onclick = () => {
                if(index === currentIndex) openZoom();
                else if(index > currentIndex) nextImage();
                else prevImage();
            };
            gallery.appendChild(div);
            cards.push(div);
        });

        function updateGallery() {
            cards.forEach((card, index) => {
                // 清除所有状态
                card.className = 'card';
                if (index === currentIndex) {
                    card.classList.add('active');
                } else if (index === currentIndex - 1) {
                    card.classList.add('prev');
                } else if (index === currentIndex + 1) {
                    card.classList.add('next');
                } else if (index < currentIndex - 1) {
                    card.classList.add('hidden-left');
                } else if (index > currentIndex + 1) {
                    card.classList.add('hidden-right');
                }
            });
        }
        updateGallery();

        function nextImage() {
            if (currentIndex < cards.length - 1 && !isZoomed) {
                currentIndex++; updateGallery();
            }
        }
        function prevImage() {
            if (currentIndex > 0 && !isZoomed) {
                currentIndex--; updateGallery();
            }
        }

        // ==========================================
        // 放大抽取逻辑
        // ==========================================
        const zoomModal = document.getElementById('zoom-modal');
        const zoomImg = document.getElementById('zoom-img');
        let isZoomed = false;

        function openZoom() {
            if (isZoomed) return;
            zoomImg.src = PHOTOS[currentIndex]; // 拿当前最高清的图
            zoomModal.classList.add('active');
            isZoomed = true;
            document.getElementById('status-tip').innerText = "✨ 张开手掌即可退出放大";
        }

        function closeZoom() {
            if (!isZoomed) return;
            zoomModal.classList.remove('active');
            isZoomed = false;
            document.getElementById('status-tip').innerText = "✋ 左右挥手切换 | 🤏 捏合抽取放大";
        }
        
        // 手机端触摸点击背景退出
        function closeZoomFallback() { closeZoom(); }

        // ==========================================
        // AI 手势识别核心逻辑 (MediaPipe)
        // ==========================================
        const videoElement = document.getElementsByClassName('input_video')[0];
        const canvasElement = document.getElementsByClassName('output_canvas')[0];
        const canvasCtx = canvasElement.getContext('2d');
        const statusTip = document.getElementById('status-tip');

        let anchorX = null;
        let lastSwipeTime = 0;

        function onResults(results) {
            // 仅绘制简单的手部连接线（隐蔽在右下角小圆圈里）
            canvasCtx.save();
            canvasCtx.clearRect(0, 0, canvasElement.width, canvasElement.height);
            canvasCtx.drawImage(results.image, 0, 0, canvasElement.width, canvasElement.height);
            
            if (results.multiHandLandmarks && results.multiHandLandmarks.length > 0) {
                const hand = results.multiHandLandmarks[0];

                // 1. 抽取放大逻辑 (判断大拇指[4]和食指[8]的距离)
                const thumb = hand[4];
                const index = hand[8];
                const pinchDist = Math.hypot(thumb.x - index.x, thumb.y - index.y);

                // 距离小于 0.05 判定为捏合（抽取），大于 0.1 判定为张开（放回）
                if (pinchDist < 0.05 && !isZoomed) {
                    openZoom();
                } else if (pinchDist > 0.1 && isZoomed) {
                    closeZoom();
                }

                // 2. 挥手切换逻辑 (判断手掌中心[9]在 X 轴上的运动)
                const palmX = hand[9].x;
                const now = Date.now();

                if (anchorX === null) anchorX = palmX;

                // 只有在没放大的时候才允许左右切换
                if (!isZoomed) {
                    if (now - lastSwipeTime > 800) { // 800ms的冷却防抖
                        const deltaX = palmX - anchorX;
                        // 注意：画面是镜像的，所以方向判定根据直觉调整
                        if (deltaX < -0.15) { 
                            nextImage(); 
                            anchorX = palmX; 
                            lastSwipeTime = now; 
                        } else if (deltaX > 0.15) { 
                            prevImage(); 
                            anchorX = palmX; 
                            lastSwipeTime = now; 
                        }
                    } else {
                        anchorX = palmX; // 冷却中持续更新锚点
                    }
                }
            } else {
                // 手离开屏幕时，重置锚点
                anchorX = null;
            }
            canvasCtx.restore();
        }

        // 初始化模型 (适配手机端性能，modelComplexity设为0)
        const hands = new Hands({locateFile: (file) => `https://cdn.jsdelivr.net/npm/@mediapipe/hands/${file}`});
        hands.setOptions({
            maxNumHands: 1, 
            modelComplexity: 0, // 核心！手机端必须用0，否则发热卡顿
            minDetectionConfidence: 0.6, 
            minTrackingConfidence: 0.6
        });
        hands.onResults(onResults);

        // 启动摄像头
        const camera = new Camera(videoElement, {
            onFrame: async () => { await hands.send({image: videoElement}); },
            width: 160, height: 160
        });
        
        camera.start().then(() => {
            statusTip.innerText = "✋ 左右移动手掌切换照片 | 🤏 双指捏合放大";
        }).catch(err => {
            statusTip.innerText = "❌ 未获取到摄像头权限，您仍可触屏点击操作";
        });

        // ==========================================
        // 手机端原生触摸滑动兼容 (兜底设计)
        // ==========================================
        let touchStartX = 0;
        document.addEventListener('touchstart', e => { touchStartX = e.changedTouches[0].screenX; });
        document.addEventListener('touchend', e => {
            if(isZoomed) return;
            const touchEndX = e.changedTouches[0].screenX;
            if(touchEndX < touchStartX - 50) nextImage();
            if(touchEndX > touchStartX + 50) prevImage();
        });

    </script>
</body>
</html>